# Valeurs publiques du projet Firebase (elles ne sont pas des secrets).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_KEY=

# true uniquement pour le développement local avec Firebase Emulator Suite.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# Variables serveur uniquement, destinées à Firebase Admin / Cloud Functions.
# Ne jamais préfixer ces variables par NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# API EcoleDirecte — serveur uniquement.
ECOLEDIRECTE_API_VERSION=4.96.3
ECOLEDIRECTE_USER_AGENT=


# Accès C-Cool — serveur uniquement.
# Les autorisations utilisent les identifiants École Directe, pas les libellés.
# Exemple réel pour PCH / 2nde 5 :
CCOOL_ALLOWED_SCHOOL_RNE=0753809H
CCOOL_ALLOWED_CLASS_ID=66

# Premier administrateur / administrateurs autorisés.
# Utilise l'ID élève École Directe (ou l'UID Firebase ed_<RNE>_<ID>).
CCOOL_ADMIN_ED_IDS=
CCOOL_ADMIN_UIDS=
CCOOL_ADMIN_EMAILS=
